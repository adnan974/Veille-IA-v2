# ─── Reddit ───────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=veille-ia-v2/0.1 by u/your_username

# ─── X (Twitter) ──────────────────────────────────────────────────────────────
X_BEARER_TOKEN=your_x_bearer_token

# ─── Notion ───────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_your_internal_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# ─── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai         # openai | anthropic
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o            # gpt-4o | claude-3-5-sonnet-20241022

# ─── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info              # trace | debug | info | warn | error
MIN_SCORE_THRESHOLD=5       # items with score < threshold are not written to Notion
LLM_BATCH_SIZE=20           # number of items per LLM call
CRON_SCHEDULE=0 8 * * *     # daily at 08:00 (cron syntax)
RUN_ONCE=false              # set to true to run once and exit (useful for CI/cron jobs)
